# Copie para .env e ajuste. O .env NUNCA vai pro git.

# Portas expostas no host (dentro dos containers continuam 8080 e 27017)
BACKEND_PORT=8080
FRONTEND_PORT=3000
MONGO_PORT=27017

# Mongo: usuário root (admin, só para manutenção)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque-esta-senha

# Mongo: usuário da aplicação (só readWrite no banco sidm)
# Use só letras e números na senha: caracteres como @ : / quebram a URI.
MONGO_APP_USER=sidm_app
MONGO_APP_PASSWORD=troque-esta-senha

# Pasta do servidor onde as imagens ficam guardadas
IMAGES_HOST_DIR=./data/images

# Login: o primeiro admin. Só é usado se ainda não existe nenhum admin ativo
# (depois, a senha que ele trocar na tela é que vale). Mínimo 8 caracteres.
SIDM_ADMIN_USER=
# o e-mail com que ele entra (opcional: sem ele, entra pelo nome de usuário)
SIDM_ADMIN_EMAIL=
SIDM_ADMIN_PASSWORD=

# Processar (pré-anotação por IA): o endereço do detector de placas, o
# container lpr-class (instalado pelo .deb splice-lpr, porta 54321).
# LPR_ADDR é o do go run: 127.0.0.1:54321 (vazio = o modelo LPR fica desligado).
# No Docker vale LPR_DOCKER_ADDR (padrão host.docker.internal:54321, o
# lpr-class publicado no host): 127.0.0.1 dentro do container é o próprio container.
LPR_ADDR=
LPR_DOCKER_ADDR=

# Processar: o contador de eixos, o container axlecounter.software (do .deb
# axlecounter.software, porta 54323). Como no LPR: AXLE_ADDR é o do go run
# (127.0.0.1:54323; vazio = desligado) e AXLE_DOCKER_ADDR o do Docker
# (padrão host.docker.internal:54323).
AXLE_ADDR=
AXLE_DOCKER_ADDR=
